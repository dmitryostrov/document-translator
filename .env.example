# The worker reads the provided local key file through a read-only secret mount.
# Change this path to another local UTF-8 key file when using a fresh checkout.
OPENAI_KEY_PATH=./.vscode/openapi-key.txt
MODEL=gpt-4.1-mini
PROVIDER_MODE=openai
APP_PORT=3100
# MCP credentials are generated by the API into a private named Docker volume.
