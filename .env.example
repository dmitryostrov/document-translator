# Required for real mode. Set an absolute path to your private UTF-8 key file
# outside the checkout, e.g. C:/Users/you/.secrets/translator-openai-key.txt.
# An unset/empty path fails Compose immediately with OPENAI_KEY_UNAVAILABLE.
OPENAI_KEY_PATH=
MODEL=gpt-6-astra
# Alternative baseline: gpt-4.1-mini. Astra uses low reasoning with standard pricing.
PROVIDER_MODE=openai
APP_PORT=3100
# MCP credentials are generated by the API into a private named Docker volume.
